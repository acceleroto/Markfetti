<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App extensions must be sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Remote images, badges and map tiles. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Read-only access outside the previewed file, so relative images (images/x.png, /docs/a.png)
	     and the containing app's renderer files load. SchemeHandler still limits documents to
	     their own folder or git repository. -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
	<array>
		<string>/</string>
	</array>
</dict>
</plist>
